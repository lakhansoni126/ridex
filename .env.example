# RideX local stack (Phase 2.2+)
# Copy to .env and adjust. Never commit .env.

# Postgres / PostGIS
POSTGRES_USER=ridex
POSTGRES_PASSWORD=ridex_dev_password
POSTGRES_DB=ridex
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Inside Compose use host `db`; for host-run API use localhost:
DATABASE_URL=postgresql+psycopg://ridex:ridex_dev_password@localhost:5432/ridex

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
LOCATION_RETENTION_DAYS=30

# Local media storage (mounted volume)
STORAGE_ROOT=/storage
MEDIA_MAX_UPLOAD_MB=10

# Mobile (Android emulator → host machine)
API_BASE_URL=http://10.0.2.2:8000
WS_BASE_URL=ws://10.0.2.2:8000
