# RideX local stack
# Copy to .env and adjust. Never commit .env.

POSTGRES_USER=ridex
POSTGRES_PASSWORD=ridex_dev_password
POSTGRES_DB=ridex
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Host-run API (outside Compose):
DATABASE_URL=postgres://ridex:ridex_dev_password@localhost:5432/ridex?sslmode=disable

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
LOCATION_RETENTION_DAYS=30

STORAGE_ROOT=./storage
MEDIA_MAX_UPLOAD_MB=10

# Phone on same Wi‑Fi (this machine's LAN). Emulator: http://10.0.2.2:8000
API_BASE_URL=http://192.168.29.37:8000
WS_BASE_URL=ws://192.168.29.37:8000
